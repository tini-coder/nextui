# Vercel AI Gateway key: https://vercel.com/ai-gateway
# On Vercel you can skip it and set MODEL instead: deployments sign in to the gateway with OIDC.
# With neither, the app answers with the scripted demo model.
AI_GATEWAY_API_KEY=

# Any gateway model id, e.g. anthropic/claude-sonnet-5.5. Setting it on Vercel turns on the real model.
MODEL=

# Optional: lets the server verify that approvals came from it.
TOOL_APPROVAL_SECRET=
