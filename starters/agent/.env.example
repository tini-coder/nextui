# Vercel AI Gateway key: https://vercel.com/ai-gateway
# On Vercel you can skip it: deployments authenticate to the gateway on their own.
AI_GATEWAY_API_KEY=

# Any gateway model id. Defaults to anthropic/claude-sonnet-5.5.
MODEL=

# Optional: lets the server verify that approvals came from it.
TOOL_APPROVAL_SECRET=
